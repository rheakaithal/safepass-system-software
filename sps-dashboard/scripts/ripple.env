# Texas A&M University
# Safe Pass Systems - RIPPLE
# Emergency Service Dashboard
# --------
# Environment variables for database.js
# DO NOT commit this file to version control — add .env to your .gitignore

# --- Web Server ---
WEBSITE_PORT=80

# --- MySQL Database ---
DB_HOST=10.247.208.34
DB_USER=Parker
DB_PASSWORD=Team13Capstone
DB_NAME=my_database

# --- MySQL Table Names ---
# Water level sensor data
DB_TABLE_USERS=users
# Cached pole status history (written by server, read by dashboard interval)
DB_TABLE_POLE_STATUS=pole_status
# Raw image tables written directly by the RIPPLE hardware
DB_TABLE_POLE1_IMAGE=pole1_image
DB_TABLE_POLE2_IMAGE=pole2_image

# --- MQTT Broker ---
MQTT_HOSTNAME=83ad0f202f85425e99ee81ecdda5e543.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=Dashboard
MQTT_PASSWORD=Team13Capstone

# --- MQTT Topics ---
# Publish: request the poles to capture and write images to the DB
MQTT_PUB_IMAGE_REQUEST=dashboard/image/request
# Publish: request an active pole status ping
MQTT_PUB_PING_REQUEST=dashboard/ping/request
# Publish: MQTT broker liveness heartbeat
MQTT_PING=dashboard/ping/test
# Subscribe: broker pushes automatic pole status updates
MQTT_SUB_PING_RESULT=sensor/ping/response
#Subscribe: DB signal to GUI
MQTT_SUB_IMAGE_STATUS=sql/image/status

# --- TIMEOUTS ---
#Defines the timeout length for image request from MySQL
LOAD_IMAGE_TIMEOUT=5000
#Defines the timeout length for full image request
IMAGE_REQUEST_TIMEOUT=360000
#Defines the timeout length for the heartbeat function
SOFT_PING_TIMEOUT=5000
#Defines the timeout length for the full ping function
HARD_PING_TIMEOUT=45000